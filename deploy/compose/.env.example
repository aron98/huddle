# Copy to .env and fill in real values before `docker compose up -d`.
# .env contains secrets — it must never be committed.
#
#   cp .env.example .env

# Domain Huddle is served on (A record -> HUDDLE_PUBLIC_IP).
HUDDLE_DOMAIN=meet.example.com

# Domain coturn is reachable on (A record -> same host).
TURN_DOMAIN=turn.example.com

# Public IP of the host. The SFU advertises this in ICE candidates.
HUDDLE_PUBLIC_IP=203.0.113.10

# Container image tag for the huddle service. Image tags mirror release
# tags without the leading v (v1.2.3 -> 1.2.3); see the release notes for
# the newest published tag. Pin a version for production — `latest` (the
# fallback when this is unset) upgrades implicitly and is not reproducible.
# Images exist from the first release tag published after the image
# workflow landed; earlier tags have no GHCR image.
HUDDLE_IMAGE_TAG=

# Persistent session-cookie HMAC key. Generate:  openssl rand -hex 32
# If unset, a random key is generated per boot and every restart logs
# everyone out.
HUDDLE_SESSION_SECRET=

# Bearer token protecting /metrics. Generate:  openssl rand -hex 16
HUDDLE_STATS_TOKEN=

# TURN REST API shared secret (issue #59): coturn runs `use-auth-secret`
# with the same value — write it into turnserver.conf's
# static-auth-secret= (its config file cannot read environment
# variables; one-liner in docs/deploy/docker-compose.md). Huddle mints
# time-limited TURN credentials from it at every join.
# Generate:  openssl rand -hex 32
TURN_SHARED_SECRET=
