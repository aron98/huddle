# Copy to .env and fill in real values before `docker compose up -d`.
# .env contains secrets — it must never be committed.
#
#   cp .env.example .env

# Domain Huddle is served on (A record -> HUDDLE_PUBLIC_IP).
HUDDLE_DOMAIN=meet.example.com

# Domain coturn is reachable on (A record -> same host).
TURN_DOMAIN=turn.example.com

# Public IP of the host. The SFU advertises this in ICE candidates.
HUDDLE_PUBLIC_IP=203.0.113.10

# Persistent session-cookie HMAC key. Generate:  openssl rand -hex 32
# If unset, a random key is generated per boot and every restart logs
# everyone out.
HUDDLE_SESSION_SECRET=

# Bearer token protecting /metrics. Generate:  openssl rand -hex 16
HUDDLE_STATS_TOKEN=

# TURN password shared by coturn (turnserver.conf user=) and the HUDDLE_ICE_SERVERS
# credential in docker-compose.yml. Generate:  openssl rand -hex 16
# After setting it here, also run the sed command from
# docs/deploy/docker-compose.md to write it into turnserver.conf.
TURN_PASSWORD=
